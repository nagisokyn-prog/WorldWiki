{
  "name": "Локация",
  "icon": "fa-map-marker-alt",
  "iconEmoji": "📍",
  "photoField": "фото",
  "tagsField": "теги",
  "titleField": "название",
  "entityType": "location",
  "sections": [
    {
      "id": "basic",
      "title": "Основные данные",
      "icon": "📝",
      "fields": [
        {
          "id": "locName",
          "type": "text",
          "label": "Название локации",
          "placeholder": "Например, Замок Драконий Камень, Трактир \"Пьяный Дракон\"",
          "path": "название",
          "required": true,
          "isSystem": true,
          "preventDelete": true,
          "preventHide": true
        },
        {
          "id": "locPhoto",
          "type": "photo",
          "label": "Изображение / Карта места",
          "placeholder": "Загрузите изображение",
          "path": "фото"
        },
        {
          "id": "locType",
          "type": "select",
          "label": "Масштаб и тип локации",
          "placeholder": "",
          "path": "тип_локации",
          "required": true,
          "options": [
            {
              "value": "интерьер",
              "label": "🚪 Помещение / Интерьер (комната, тронный зал, каюта)"
            },
            {
              "value": "здание",
              "label": "🏰 Здание / Сооружение (замок, трактир, бункер, маяк)"
            },
            {
              "value": "микро_точка",
              "label": "📍 Точка на местности (мост, перекресток, площадь, поляна)"
            },
            {
              "value": "поселение",
              "label": "🏘️ Поселение / Город (деревня, мегаполис, станция)"
            },
            {
              "value": "природная_зона",
              "label": "🌲 Природный ландшафт (лес, перевал, болото, пещера)"
            },
            {
              "value": "гео_регион",
              "label": "🗺️ Географический регион (остров, долина, архипелаг, пустошь)"
            },
            {
              "value": "макро_объект",
              "label": "🪐 Планета / Астрономический объект / Сектор"
            }
          ],
          "isSystem": true,
          "preventDelete": true,
          "preventHide": true
        },
        {
          "id": "locBuildingSubtype",
          "type": "select",
          "label": "Специализация здания / заведения",
          "placeholder": "",
          "path": "тип_заведения",
          "options": [
            {
              "value": "residential",
              "label": "🏡 Жилое (частный дом, усадьба, поместье, вилла)"
            },
            {
              "value": "hospitality",
              "label": "🍺 Общепит и ночлег (бар, таверна, гостиница, ресторан, трактир)"
            },
            {
              "value": "medical",
              "label": "🏥 Медицинское (больница, лечебница, лазарет, аптека)"
            },
            {
              "value": "educational",
              "label": "🎓 Образовательное (школа, академия, университет, пансион)"
            },
            {
              "value": "administrative",
              "label": "🏛️ Административное / Государственное (ратуша, суд, полиция, посольство)"
            },
            {
              "value": "military",
              "label": "⚔️ Военное / Оборонительное (казарма, форт, сторожевая башня, бункер)"
            },
            {
              "value": "religious",
              "label": "⛪ Религиозное (храм, святилище, монастырь, часовня)"
            },
            {
              "value": "commercial",
              "label": "💰 Торговое (рынок, лавка, торговый центр, фактория)"
            },
            {
              "value": "industrial",
              "label": "⚒️ Производственное (кузница, шахта, верфь, завод, фабрика)"
            }
          ]
        },
        {
          "id": "locParent",
          "type": "select",
          "label": "Входит в локацию (Родитель)",
          "placeholder": "Выберите родительскую локацию...",
          "path": "родительская_локация",
          "hint": "Формирует географическую иерархию (Комната ⊂ Здание ⊂ Город ⊂ Регион). Координаты и время наследуются вверх!",
          "entityType": "location",
          "isSystem": true,
          "preventDelete": true,
          "preventHide": true
        },
        {
          "id": "locStatus",
          "type": "select",
          "label": "Статус локации",
          "placeholder": "",
          "path": "статус_категория",
          "required": true,
          "options": [
            {
              "value": "Действует",
              "label": "🟢 Действует / Существует / Доступна"
            },
            {
              "value": "Разрушена / Руины",
              "label": "🔴 Разрушена / В руинах"
            },
            {
              "value": "Заброшена",
              "label": "🟡 Заброшена"
            },
            {
              "value": "Закрыта на карантин",
              "label": "🟠 Закрыта на карантин"
            },
            {
              "value": "Строится",
              "label": "⚪ Строится / В процессе возведения"
            },
            {
              "value": "Скрыта / Затоплена",
              "label": "🟣 Скрыта / Затоплена / Недоступна"
            }
          ],
          "isSystem": true,
          "preventDelete": true,
          "preventHide": true
        },
        {
          "id": "locState",
          "type": "select",
          "label": "Государство / Держава (Юрисдикция)",
          "placeholder": "Выберите государство...",
          "path": "принадлежность_государству",
          "hint": "Наследуется от родительской локации, если не указано явно",
          "entityType": "state",
          "isSystem": true,
          "preventDelete": true,
          "preventHide": true
        },
        {
          "id": "locOwner",
          "type": "select",
          "label": "Владелец / Управляющий / Директор",
          "placeholder": "Выберите персонажа...",
          "path": "владелец_управляющий",
          "entityType": "character",
          "isSystem": true,
          "preventDelete": true,
          "preventHide": true
        },
        {
          "id": "locFaction",
          "type": "select",
          "label": "Фактический контроль (Фракция / Гарнизон)",
          "placeholder": "Выберите контролирующую организацию...",
          "path": "контролирующая_фракция",
          "entityType": "organization",
          "isSystem": true,
          "preventDelete": true,
          "preventHide": true
        },
        {
          "id": "locTags",
          "type": "tags",
          "label": "Теги",
          "placeholder": "Введите теги через Enter",
          "path": "теги"
        },
        {
          "id": "locDescription",
          "type": "textarea",
          "label": "Краткое описание места",
          "placeholder": "Общее визуальное и смысловое описание...",
          "path": "описание",
          "rows": 4
        }
      ],
      "dynamicContainers": []
    },
    {
      "id": "building_details",
      "title": "Специфика здания и заведения",
      "icon": "🚪",
      "fields": [
        {
          "id": "locAddress",
          "type": "text",
          "label": "Почтовый адрес / Ориентир",
          "placeholder": "Например, ул. Вязов, д. 13 или Северный тракт у развилки",
          "path": "адрес"
        },
        {
          "id": "locCapacity",
          "type": "number",
          "label": "Вместимость (человек / мест / коек)",
          "placeholder": "Например, 120",
          "path": "вместимость",
          "min": 0
        },
        {
          "id": "locAccessMode",
          "type": "select",
          "label": "Режим доступа",
          "placeholder": "",
          "path": "режим_доступа",
          "options": [
            {
              "value": "public",
              "label": "🟢 Публичный доступ"
            },
            {
              "value": "service",
              "label": "🟡 Служебный доступ"
            },
            {
              "value": "private",
              "label": "🔵 Приватный / Частный"
            },
            {
              "value": "secret",
              "label": "🟣 Секретный объект"
            },
            {
              "value": "closed",
              "label": "🔴 Закрыто"
            }
          ]
        },
        {
          "id": "locOperatingHours",
          "type": "text",
          "label": "Часы работы / Режим дня",
          "placeholder": "Например, Круглосуточно или с 08:00 до 20:00 или От заката до рассвета",
          "path": "режим_работы"
        }
      ],
      "dynamicContainers": []
    },
    {
      "id": "geography",
      "title": "География, Координаты и Астрономия",
      "icon": "🌲",
      "fields": [
        {
          "id": "locPlanetId",
          "type": "text",
          "label": "Планета размещения (ID или Master-планета)",
          "placeholder": "Оставьте пустым для автоопределения или укажите ID планеты",
          "path": "планета_id",
          "hint": "Планета размещения локации (по умолчанию планета мира)"
        },
        {
          "id": "locTimezone",
          "type": "select",
          "label": "Часовой пояс локации",
          "placeholder": "Выберите часовой пояс...",
          "path": "часовой_пояс",
          "hint": "При пустом значении наследуется от родительского города или государства",
          "entityType": "timezone"
        },
        {
          "id": "locLatitude",
          "type": "number",
          "label": "Широта (градусы -90 .. +90)",
          "placeholder": "54.5",
          "path": "широта",
          "min": -90,
          "max": 90
        },
        {
          "id": "locLongitude",
          "type": "number",
          "label": "Долгота (градусы -180 .. +180)",
          "placeholder": "37.6",
          "path": "долгота",
          "min": -180,
          "max": 180
        },
        {
          "id": "locClimateZone",
          "type": "select",
          "label": "Климатический пояс",
          "placeholder": "",
          "path": "климатический_пояс",
          "options": [
            {
              "value": "equatorial",
              "label": "🌴 Экваториальный"
            },
            {
              "value": "tropical",
              "label": "☀️ Тропический"
            },
            {
              "value": "temperate",
              "label": "🍂 Умеренный"
            },
            {
              "value": "subarctic",
              "label": "❄️ Субарктический"
            },
            {
              "value": "polar",
              "label": "🧊 Полярный / Арктический"
            }
          ]
        },
        {
          "id": "locClimate",
          "type": "text",
          "label": "Особенности климата и погоды",
          "placeholder": "Например, суровый северный, частые дожди",
          "path": "климат"
        },
        {
          "id": "locLandscape",
          "type": "text",
          "label": "Ландшафт и рельеф",
          "placeholder": "Например, скалистые горы, густые хвойные леса",
          "path": "ландшафт"
        },
        {
          "id": "locArea",
          "type": "text",
          "label": "Площадь / Протяженность",
          "placeholder": "Например, 150 кв. км",
          "path": "площадь"
        },
        {
          "id": "locDangerLevel",
          "type": "range",
          "label": "Уровень опасности (0-100)",
          "placeholder": "",
          "path": "уровень_опасности",
          "min": 0,
          "max": 100,
          "value": 10
        },
        {
          "id": "locResources",
          "type": "textarea",
          "label": "Природные ресурсы и флора/фауна",
          "placeholder": "Добываемые минералы, редкие травы, опасные хищники...",
          "path": "ресурсы",
          "rows": 3
        }
      ],
      "dynamicContainers": []
    },
    {
      "id": "culture",
      "title": "Население и общество",
      "icon": "👥",
      "fields": [
        {
          "id": "locPopulation",
          "type": "text",
          "label": "Численность населения",
          "placeholder": "Например, 50 000 жителей",
          "path": "население"
        },
        {
          "id": "locDemographics",
          "type": "textarea",
          "label": "Демографический состав и расы",
          "placeholder": "70% людей, 20% гномов, 10% эльфов...",
          "path": "демография",
          "rows": 3
        },
        {
          "id": "locLanguages",
          "type": "text",
          "label": "Основные языки и диалекты",
          "placeholder": "Например, Всеобщий, Древний нордский",
          "path": "языки"
        },
        {
          "id": "locTraditions",
          "type": "textarea",
          "label": "Культура, праздники и обычаи",
          "placeholder": "Местные законы, празднества, религиозные культы...",
          "path": "культура",
          "rows": 3
        }
      ],
      "dynamicContainers": []
    },
    {
      "id": "architecture",
      "title": "Архитектура и объекты",
      "icon": "🏰",
      "fields": [
        {
          "id": "locArchStyle",
          "type": "text",
          "label": "Архитектурный стиль",
          "placeholder": "Например, готика, киберпанк, древний монолит",
          "path": "архитектурный_стиль"
        },
        {
          "id": "locKeyBuildings",
          "type": "textarea",
          "label": "Ключевые сооружения и достопримечательности",
          "placeholder": "Главная ратуша, часовая башня, рынок, казармы...",
          "path": "ключевые_объекты",
          "rows": 4
        },
        {
          "id": "locDefenses",
          "type": "textarea",
          "label": "Оборона и укрепления",
          "placeholder": "Крепостные стены, защитные магические барьеры, гарнизон...",
          "path": "оборона",
          "rows": 3
        }
      ],
      "dynamicContainers": []
    },
    {
      "id": "history",
      "title": "Хронология и эволюция",
      "icon": "⏳",
      "fields": [],
      "dynamicContainers": [
        {
          "id": "controlTimeline",
          "type": "timeline",
          "title": "Эволюция контроля и владельцев",
          "emptyMessage": "Смены власти не зафиксированы",
          "template": "Базовая хронология",
          "dataPath": "эволюция_контроля",
          "fieldOverrides": {
            "название": {
              "label": "Владелец / Фракция у власти",
              "type": "select",
              "entityType": "organization"
            },
            "описание_1": {
              "label": "Обстоятельства смены власти / Осада / Договор"
            },
            "статус_категория": {
              "hidden": true
            },
            "описание_2": {
              "hidden": true
            },
            "описание_3": {
              "hidden": true
            },
            "числовой_показатель": {
              "hidden": true
            }
          }
        },
        {
          "id": "locationEvents",
          "type": "timeline",
          "title": "Ключевые исторические события места",
          "emptyMessage": "Исторические события не добавлены",
          "template": "Динамический элемент",
          "dataPath": "исторические_события",
          "fieldOverrides": {
            "название": {
              "label": "Название битвы / события"
            },
            "описание_1": {
              "label": "Последствия для локации"
            },
            "статус_категория": {
              "hidden": true
            },
            "описание_2": {
              "hidden": true
            },
            "описание_3": {
              "hidden": true
            },
            "числовой_показатель": {
              "hidden": true
            }
          }
        }
      ]
    },
    {
      "id": "relations",
      "title": "Связи и маршруты",
      "icon": "🕸️",
      "fields": [],
      "dynamicContainers": [
        {
          "id": "locationConnections",
          "type": "dynamic",
          "title": "Торговые и стратегические связи",
          "emptyMessage": "Связи не добавлены",
          "template": "Двунаправленная связь",
          "dataPath": "связанные_локации"
        }
      ]
    }
  ]
}
