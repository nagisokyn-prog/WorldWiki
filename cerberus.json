{
  "$schema": "https://cerberus-firewall.dev/schema.json",
  "version": "1.0",
  "ignore": [
    ".logic_legacy/**",
    "tests/fixtures/**",
    "target/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "**/libs/**",
    "**/*.min.js",
    "**/*.prod.js",
    "vendor/**",
    "crates/**",
    "src/dist-check/**",
    "__tests__/**",
    "**/tests/**",
    "**/test/",
    "**/*test.ts"
  ],
  "extends": [
    "cerberus:rust-hexagonal",
    "cerberus:vue-clean-architecture",
    "cerberus:fsd-strict",
    "cerberus:perf-high-fps",
    "cerberus:css-design-tokens"
  ],
  "layers": {
    "domain": {
      "forbidden_external": ["tokio", "reqwest", "tauri", "surrealdb"],
      "allowed_deps": []
    },
    "application": {
      "forbidden_external": ["tauri"],
      "allowed_deps": ["domain", "ports"]
    },
    "ports": {
      "forbidden_external": ["tauri", "surrealdb"],
      "allowed_deps": ["domain"]
    },
    "infrastructure": {
      "allowed_deps": ["domain", "ports"]
    },
    "adapters_tauri": {
      "allowed_external": ["tauri"],
      "allowed_deps": ["domain", "application", "ports"]
    }
  },
  "frontend_layers": {
    "shared": {
      "order": 1,
      "allowed_deps": []
    },
    "entities": {
      "order": 2,
      "aliases": ["entity"],
      "allowed_deps": ["shared"]
    },
    "features": {
      "order": 3,
      "aliases": ["feature"],
      "allowed_deps": ["entities", "shared"]
    },
    "widgets": {
      "order": 4,
      "aliases": ["widget"],
      "allowed_deps": ["features", "entities", "shared"]
    },
    "pages": {
      "order": 5,
      "aliases": ["page", "views", "view", "screens", "screen"],
      "allowed_deps": ["widgets", "features", "entities", "shared"]
    },
    "app": {
      "order": 6,
      "aliases": ["application"],
      "allowed_deps": ["shell", "pages", "widgets", "features", "entities", "shared"]
    },
    "shell": {
      "order": 6,
      "is_orchestrator": true,
      "allow_cross_slice": true,
      "allowed_deps": ["pages", "widgets", "features", "entities", "shared", "app"]
    }
  },
  "limits": {
    "max_sloc_warn": 300,
    "max_sloc_deny": 500,
    "max_pressure_warn": 200.0,
    "max_pressure_deny": 400.0,
    "max_style_lines": 0,
    "max_script_setup_lines": 0
  },
  "rules": {
    "arch/domain-purity": "deny",
    "arch/ports-isolation": "deny",
    "arch/tauri-isolation": "deny",
    "arch/manifest-hierarchy": "deny",
    "arch/missing-layer": "warn",
    "arch/zone-of-pain": "warn",
    "arch/god-object-blast-radius": "warn",

    "code/max-pressure": "warn",
    "code/max-sloc": "deny",

    "async/no-sync-mutex-in-await": "deny",
    "async/no-zombie-spawn": "warn",

    "robustness/no-raw-unwrap-panic": "warn",
    "quality/ai-slop-detector": "warn",

    "sec/taint-sink-execution": "deny",
    "sec/transitive-capabilities": "warn",

    "vue/no-monolith-script-setup": "deny",
    "vue/require-companion-hook": "deny",
    "vue/no-types-in-sfc": "deny",

    "css/no-hardcoded-colors": "deny",
    "css/require-design-tokens": "deny",
    "css/max-style-lines": "warn",

    "fsd/layer-imports-hierarchy": "deny",
    "fsd/public-api-only": "deny",
    "fsd/ui-kit-zero-domain": "deny",
    "fsd/no-cross-slice-imports": "deny",

    "perf/shallow-ref-for-heavy-ast": "deny",
    "perf/no-reactive-canvas-three": "deny",
    "perf/no-allocations-in-raf": "deny",
    "perf/no-template-methods-in-loops": "deny",
    "perf/no-cascading-watchers": "deny",

    "leak/uncleaned-ipc-listener": "deny"
  }
}
