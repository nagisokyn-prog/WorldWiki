{
  "name": "world-wiki",
  "private": true,
  "version": "0.85.0",
  "type": "module",
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "dev": "pnpm --filter @worldwiki/spa dev",
    "build": "pnpm -r --stream build",
    "preview": "vp preview",
    "tauri": "tauri",
    "typecheck": "pnpm -r --stream typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "npx stylelint \"packages/resources/src/styles/**/*.css\"",
    "format": "oxfmt --write src/ts",
    "test": "pnpm -r --stream test",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:guard": "cargo test --manifest-path crates/Cargo.toml --workspace",
    "cov:guard": "cargo llvm-cov --manifest-path crates/Cargo.toml --workspace",
    "cov:guard:html": "cargo llvm-cov --manifest-path crates/Cargo.toml --workspace --html --open",
    "build:test-addon": "cargo build --manifest-path e2e/Cargo.toml",
    "test:e2e:rust": "cargo test --manifest-path e2e/Cargo.toml --test \"*\"",
    "test:e2e:ui": "vitest run --config e2e/fullstack/vitest.e2e.config.ts",
    "test:e2e": "pnpm test:e2e:rust && pnpm test:e2e:ui",

    "generate:api": "node scripts/codegen.js",
    "audit:god-files": "node detect_god_files.js"

  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@tanstack/vue-query": "5.102.8",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@vueuse/motion": "^3.0.3",
    "dompurify": "^3.4.14",
    "lowlight": "^3.3.0",
    "markdown-it": "^15.0.1",
    "pinia": "4.0.3",
    "turndown": "^7.2.4",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.0",
    "@types/turndown": "^5.0.6",
    "@typescript/typescript6": "npm:typescript@~6.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/server-renderer": "3.5.42",
    "@vue/test-utils": "^2.5.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "markdown-coverage-reporter": "^1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vc-api-coverage": "^0.8.6",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-dts": "5.1.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
