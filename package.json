{
  "name": "world-wiki",
  "private": true,
  "version": "0.85.0",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "dev": "pnpm --filter @worldwiki/spa dev",
    "build": "pnpm -r --stream build",
    "preview": "vp preview",
    "tauri": "tauri",
    "typecheck": "pnpm -r --stream typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "npx stylelint \"packages/resources/src/styles/**/*.css\"",
    "format": "oxfmt --write src/ts",
    "test": "pnpm -r --stream test",
    "test:run": "vitest run",
    "test:turbo": "turbo-test",
    "test:coverage": "vitest run --coverage",
    "test:guard": "cargo test --manifest-path crates/Cargo.toml --workspace",
    "cov:guard": "cargo llvm-cov --manifest-path crates/Cargo.toml --workspace",
    "cov:guard:html": "cargo llvm-cov --manifest-path crates/Cargo.toml --workspace --html --open",
    "build:test-addon": "cargo build --manifest-path e2e/Cargo.toml --config e2e/msvc-linker.toml --target-dir e2e/target && node -e \"require('node:fs').copyFileSync('e2e/target/debug/worldwiki_e2e.dll', 'e2e/prebuilt/worldwiki_e2e.node'); require('node:fs').copyFileSync('e2e/target/debug/worldwiki_e2e.dll', 'e2e/target/debug/worldwiki_e2e.node');\"",
    "test:e2e:rust": "cargo test --manifest-path e2e/Cargo.toml --config e2e/msvc-linker.toml --target-dir e2e/target --test \"*\"",
    "test:e2e:ui": "vitest run --config e2e/fullstack/vitest.e2e.config.ts",
    "test:e2e": "pnpm test:e2e:rust && pnpm test:e2e:ui",

    "generate:api": "node scripts/codegen.js",
    "audit:god-files": "node detect_god_files.js",
    "audit:macro-commands": "node scripts/find_macroable_commands.mjs",
    "migrate:macro-commands": "node scripts/migrate_to_bridge_macros.mjs --write"

  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@tanstack/vue-query": "5.105.1",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
    "@tiptap/extension-heading": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-paragraph": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-table-cell": "^3.32.2",
    "@tiptap/extension-table-header": "^3.32.2",
    "@tiptap/extension-table-row": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/vue-3": "^3.32.2",
    "@vueuse/motion": "^3.0.3",
    "dompurify": "^3.4.17",
    "lowlight": "^3.3.0",
    "markdown-it": "^15.0.3",
    "pinia": "4.1.0",
    "turndown": "^7.2.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.17",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "@typescript/typescript6": "npm:typescript@~6.0.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/server-renderer": "3.5.44",
    "@vue/test-utils": "^2.5.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "markdown-coverage-reporter": "^1.0.0-alpha.6",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vc-api-coverage": "^0.8.6",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  }
}
