{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "world-wiki",
  "version": "0.20.0",
  "identifier": "com.worldwiki.app",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "World Wiki",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "url": "splash.html",
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["wwiki"],
        "name": "WorldWiki Backup",
        "description": "WorldWiki Backup Archive",
        "role": "Editor"
      }
    ]
  }
}