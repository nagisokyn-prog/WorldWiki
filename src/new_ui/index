                </div>
                <div class="wheel-wrapper" ref="wrapper" tabindex="0">
                    <div class="wheel-container" ref="container"></div>
                </div>
            </div>
        `,
        props: ['modelValue', 'options'], emits: ['update:modelValue', 'hover-start', 'hover-end'],
        data() { return { wheel: null } },
        mounted() {
            this.wheel = new VanillaXboxWheel(this.$refs.trigger, this.$refs.wrapper, this.$refs.container, this.$refs.arrow, this.$refs.text, this.options, this.modelValue, (val) => this.$emit('update:modelValue', val));
            this.$refs.trigger.addEventListener('mouseenter', () => this.$emit('hover-start'));
            this.$refs.trigger.addEventListener('mouseleave', () => this.$emit('hover-end'));
        }
    };

