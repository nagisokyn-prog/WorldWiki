    const { createApp, ref, computed, watch, onMounted, nextTick } = Vue;

    // --- Vanilla 3D Xbox Wheel Class ---
    class VanillaXboxWheel {
        constructor(triggerEl, wrapperEl, containerEl, arrowEl, textEl, options, defaultValue, onUpdate) {
            this.trigger = triggerEl; this.wrapper = wrapperEl; this.container = containerEl;
            this.arrow = arrowEl; this.textEl = textEl; this.options = options;
            this.currentIndex = Math.max(0, options.indexOf(defaultValue));
            this.LEN = options.length; this.ITEM_HEIGHT = 44; this.wheelAcc = 0;
            this.onUpdate = onUpdate; this.isOpen = false;
            this.init();
        }
        init() {
            this.render(); this.updateWheel();
            this.trigger.addEventListener('click', (e) => { e.stopPropagation(); this.toggle(); });
            this.wrapper.addEventListener('wheel', (e) => {
                e.preventDefault(); this.wheelAcc += e.deltaY;
                if (Math.abs(this.wheelAcc) > 30) {
                    if (this.wheelAcc > 0) this.next(); else this.prev();
                    this.wheelAcc = 0;
                }
            });
            this.wrapper.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowDown') { e.preventDefault(); this.next(); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); this.prev(); }
                else if (e.key === 'Enter' || e.key === 'Escape') this.close();
            });
        }
        render() {
            this.container.innerHTML = '';
            this.options.forEach((opt, i) => {
                const div = document.createElement('div'); div.className = 'wheel-item'; div.textContent = opt;
                div.addEventListener('click', (e) => { e.stopPropagation(); this.select(i); });
                this.container.appendChild(div);
            });
            this.items = this.container.querySelectorAll('.wheel-item');
        }
        updateWheel() {
            if (!this.items) return;
            this.items.forEach((item, i) => {
                let diff = i - this.currentIndex;
                const half = Math.floor(this.LEN / 2);
                if (diff > half) diff -= this.LEN;
                if (diff < -half) diff += this.LEN;
                let scale = 1, opacity = 1;
                if (diff === 0) { item.classList.add('active'); scale = 1.15; opacity = 1; }
                else if (Math.abs(diff) === 1) { item.classList.remove('active'); scale = 0.9; opacity = 0.5; }
                else if (Math.abs(diff) === 2) { item.classList.remove('active'); scale = 0.75; opacity = 0.2; }
                else { item.classList.remove('active'); opacity = 0; }
                item.style.transform = `translateY(${diff * this.ITEM_HEIGHT}px) scale(${scale})`;
                item.style.opacity = opacity; item.style.zIndex = 10 - Math.abs(diff);
            });
            const val = this.options[this.currentIndex];
            this.textEl.textContent = val;
            if (this.onUpdate) this.onUpdate(val);
        }
        next() { this.currentIndex = (this.currentIndex + 1) % this.LEN; this.updateWheel(); }
        prev() { this.currentIndex = (this.currentIndex - 1 + this.LEN) % this.LEN; this.updateWheel(); }
        select(index) { this.currentIndex = index; this.updateWheel(); setTimeout(() => this.close(), 150); }
        toggle() { if (this.isOpen) this.close(); else this.open(); }
        open() {
            document.querySelectorAll('.wheel-wrapper.expanded').forEach(w => { w.classList.remove('expanded'); w.previousElementSibling?.classList.remove('active'); });
            this.wrapper.classList.add('expanded'); this.trigger.classList.add('active'); this.arrow.classList.add('rotated');
            this.isOpen = true; this.wrapper.focus();
        }
        close() { this.wrapper.classList.remove('expanded'); this.trigger.classList.remove('active'); this.arrow.classList.remove('rotated'); this.isOpen = false; }
    }

