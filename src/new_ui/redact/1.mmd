stateDiagram-v2
    [*] --> Черновик : Создание новой главы

    state Черновик {
        [*] --> Написание
        Написание --> Автосохранение
        Автосохранение --> Написание
    }

    Черновик --> На_проверке : Отправка редактору
    
    На_проверке --> Доработка : Найдены сюжетные дыры
    Доработка --> На_проверке : Внесены исправления
    
    На_проверке --> Опубликована : Текст утвержден

    Опубликована --> В_архиве : Снятие с публикации
    В_архиве --> Черновик : Восстановление для переписывания

    Опубликована --> [*]