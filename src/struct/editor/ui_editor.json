{
  "name": "Шаблон статьи World Wiki",
  "icon": "fa-book",
  "iconEmoji": "📖",
  "photoField": "фото",
  "tagsField": "теги",
  "titleField": "название",
  "entityType": "generic",
  "sections": [
    {
      "id": "основное",
      "title": "Основная информация",
      "icon": "📝",
      "fields": [
        {
          "id": "название",
          "type": "text",
          "label": "Название / Имя",
          "required": true,
          "placeholder": "Введите имя персонажа, локации или предмета",
          "path": "название"
        },
        {
          "id": "фото",
          "type": "photo",
          "label": "Аватар / Изображение",
          "placeholder": "Загрузите иллюстрацию",
          "path": "фото"
        },
        {
          "id": "тип_сущности",
          "type": "select",
          "label": "Категория статьи",
          "required": true,
          "options": [
            { "value": "", "label": "Не указано" },
            { "value": "персонаж", "label": "👤 Персонаж" },
            { "value": "локация", "label": "🗺️ Локация" },
            { "value": "организация", "label": "🏢 Фракция / Организация" },
            { "value": "предмет", "label": "🗡️ Артефакт / Предмет" },
            { "value": "событие", "label": "🔥 Историческое событие" }
          ],
          "placeholder": "О чем эта статья?",
          "path": "тип_сущности"
        },
        {
          "id": "статус",
          "type": "select",
          "label": "Текущий статус в сюжете",
          "options": [
            { "value": "", "label": "Неизвестно" },
            { "value": "жив", "label": "🟢 Жив / Действует" },
            { "value": "мертв", "label": "🔴 Мертв / Уничтожен" },
            { "value": "пропал", "label": "🟡 Пропал без вести / Заброшен" }
          ],
          "placeholder": "В каком состоянии объект сейчас?",
          "path": "статус"
        },
        {
          "id": "дата_появления",
          "type": "calendar_date",
          "label": "Дата появления / Рождения",
          "placeholder": "Выберите дату по календарю",
          "hint": "Точная дата появления в мире",
          "path": "дата_появления"
        },
        {
          "id": "теги",
          "type": "tags",
          "label": "Теги (через Enter)",
          "placeholder": "Например: Маг, Эльф, Артефакт...",
          "hint": "Ключевые слова для быстрого поиска",
          "path": "теги"
        },
        {
          "id": "краткое_описание",
          "type": "textarea",
          "label": "Краткая выжимка (Спойлер-фри)",
          "rows": 3,
          "placeholder": "Одно-два предложения: кто это или что это в общих чертах.",
          "path": "краткое_описание"
        }
      ],
      "dynamicContainers": []
    },
    {
      "id": "детальное_описание",
      "title": "Детальное описание",
      "icon": "📜",
      "fields": [
        {
          "id": "биография",
          "type": "textarea",
          "label": "Полная история (Лор / Биография)",
          "rows": 8,
          "placeholder": "Подробный рассказ о жизни, происхождении, мотивах и ключевых решениях...",
          "path": "биография"
        },
        {
          "id": "внешность",
          "type": "textarea",
          "label": "Внешность / Описание",
          "rows": 5,
          "placeholder": "Детальное описание внешнего вида, одежды, отличительных черт...",
          "path": "внешность"
        },
        {
          "id": "характер",
          "type": "textarea",
          "label": "Характер / Особенности",
          "rows": 5,
          "placeholder": "Психологический портрет, привычки, страхи, манера общения...",
          "path": "характер"
        }
      ],
      "dynamicContainers": []
    },
    {
      "id": "характеристики",
      "title": "Характеристики",
      "icon": "📊",
      "fields": [
        {
          "id": "опасность",
          "type": "range",
          "label": "Уровень силы / Опасности (0-100)",
          "min": 0,
          "max": 100,
          "value": 10,
          "path": "уровень_опасности"
        },
        {
          "id": "возраст",
          "type": "number",
          "label": "Примерный возраст",
          "min": 0,
          "max": 999999,
          "value": 0,
          "placeholder": "Возраст в годах",
          "path": "возраст"
        },
        {
          "id": "раса",
          "type": "text",
          "label": "Раса / Происхождение",
          "placeholder": "Например: Человек, Высший Эльф, Нежить...",
          "path": "раса"
        },
        {
          "id": "принадлежность",
          "type": "select",
          "label": "Ключевая фракция (если есть)",
          "entityType": "organization",
          "placeholder": "Выберите организацию...",
          "path": "фракция"
        },
        {
          "id": "способности",
          "type": "multiselect",
          "label": "Известные навыки / Таланты",
          "options": [
            { "value": "магия", "label": "✨ Магия" },
            { "value": "оружие", "label": "⚔️ Владение оружием" },
            { "value": "скрытность", "label": "🥷 Скрытность" },
            { "value": "убеждение", "label": "🗣️ Дипломатия" }
          ],
          "placeholder": "Выберите известные навыки",
          "path": "способности"
        }
      ],
      "dynamicContainers": []
    },
    {
      "id": "отношения",
      "title": "Связи",
      "icon": "🤝",
      "fields": [],
      "dynamicContainers": [
        {
          "id": "связи",
          "type": "dynamic",
          "title": "Взаимоотношения с другими сущностями",
          "emptyMessage": "Связи не добавлены. Здесь можно указать союзников, врагов, семью или привязанность к предметам/местам.",
          "template": "Взаимоотношение",
          "dataPath": "отношения"
        }
      ]
    },
    {
      "id": "хронология",
      "title": "Сюжетная линия",
      "icon": "⏳",
      "fields": [],
      "dynamicContainers": [
        {
          "id": "события",
          "type": "timeline",
          "title": "Таймлайн ключевых событий",
          "emptyMessage": "События не добавлены. Добавьте сюда важные вехи в истории объекта.",
          "template": "Событие",
          "dataPath": "хронология"
        }
      ]
    },
    {
      "id": "дополнительно",
      "title": "Заметки",
      "icon": "📌",
      "fields": [],
      "dynamicContainers": [
        {
          "id": "интересные_факты",
          "type": "dynamic",
          "title": "Интересные факты и мелочи",
          "emptyMessage": "Заметок нет.",
          "template": "Заметка",
          "dataPath": "факты"
        }
      ]
    }
  ],
  "templates": {
    "Взаимоотношение": {
      "type": "dynamic",
      "isBidirectional": true,
      "bidirectionalLinkClass": "целевая_сущность",
      "headerTitle": "Связь",
      "fields": [
        {
          "type": "select",
          "class": "тип_сущности",
          "label": "С кем/чем связь?",
          "options": [
            { "value": "character", "label": "👤 Персонаж" },
            { "value": "organization", "label": "🏢 Организация" },
            { "value": "state", "label": "🗺️ Государство" },
            { "value": "generic", "label": "🧩 Другое (Предмет/Локация)" }
          ],
          "placeholder": "Выберите тип сущности"
        },
        {
          "type": "select",
          "class": "целевая_сущность",
          "label": "Выбор объекта",
          "entityType": "generic",
          "placeholder": "Укажите с кем именно..."
        },
        {
          "type": "select",
          "class": "характер_связи",
          "label": "Характер отношений",
          "options": [
            { "value": "союзник", "label": "🤝 Союзник / Друг" },
            { "value": "враг", "label": "⚔️ Враг / Соперник" },
            { "value": "родственник", "label": "🩸 Родственник" },
            { "value": "нейтрал", "label": "⚪ Нейтрально" },
            { "value": "владелец", "label": "👑 Владелец / Лидер" }
          ],
          "placeholder": "Как они относятся друг к другу?"
        },
        {
          "type": "textarea",
          "class": "описание_связи",
          "rows": 2,
          "placeholder": "Кратко опишите их отношения или историю знакомства..."
        }
      ],
      "dynamicContainers": [
        {
          "id": "эволюция_отношений",
          "type": "timeline",
          "title": "Как менялись их отношения в сюжете",
          "emptyMessage": "Изменения не добавлены.",
          "template": "Изменение отношения",
          "dataPath": "динамика_отношений"
        }
      ],
      "itemClass": "dynamic-item"
    },
    "Изменение отношения": {
      "type": "timeline",
      "headerTitle": "Этап отношений",
      "fields": [
        {
          "type": "select",
          "class": "начальная_глава",
          "label": "В какой главе началось?",
          "entityType": "chapter",
          "placeholder": "Начало"
        },
        {
          "type": "select",
          "class": "конечная_глава",
          "label": "В какой главе закончилось?",
          "entityType": "chapter",
          "placeholder": "Конец (опционально)"
        },
        {
          "type": "range",
          "class": "уровень_доверия",
          "min": -100,
          "max": 100,
          "value": 0,
          "label": "Уровень доверия (-100 вражда, 100 братство)"
        },
        {
          "type": "text",
          "class": "причина",
          "placeholder": "Что послужило причиной изменения отношений?"
        }
      ],
      "itemClass": "relationship-state-item"
    },
    "Событие": {
      "type": "timeline",
      "headerTitle": "Событие",
      "fields": [
        {
          "type": "select",
          "class": "глава",
          "label": "Глава / Эпизод",
          "entityType": "chapter",
          "placeholder": "К какой главе относится событие?"
        },
        {
          "type": "text",
          "class": "название_события",
          "placeholder": "Название события (например 'Битва за Замок')"
        },
        {
          "type": "textarea",
          "class": "описание_события",
          "rows": 3,
          "placeholder": "Что именно произошло и какие последствия имело?"
        }
      ],
      "itemClass": "timeline-item"
    },
    "Заметка": {
      "type": "dynamic",
      "headerTitle": "Факт",
      "fields": [
        {
          "type": "text",
          "class": "заголовок",
          "placeholder": "Тема факта (например 'Любимое блюдо')"
        },
        {
          "type": "textarea",
          "class": "содержание",
          "rows": 2,
          "placeholder": "Описание факта..."
        }
      ],
      "itemClass": "dynamic-item"
    }
  },
  "api": {
    "list": "/api/project/{project}/generic",
    "save": "/api/project/{project}/generic",
    "delete": "/api/project/{project}/generic/{id}"
  }
}