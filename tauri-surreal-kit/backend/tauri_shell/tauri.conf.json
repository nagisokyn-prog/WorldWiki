{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TauriSurrealKit",
  "version": "1.0.0",
  "identifier": "com.worldwiki.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tauri Surreal Kit",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "url": "shell/splash.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*",
          "$APPDATA/**/*",
          "$DOCUMENT/**/*",
          "$DESKTOP/**/*",
          "$PICTURE/**/*",
          "$VIDEO/**/*",
          "$DOWNLOAD/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
