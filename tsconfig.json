{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/ts/*"
      ],
      "@services/*": [
        "./src/ts/services/*"
      ],
      "@components/*": [
        "./src/ts/components/*"
      ],
      "@utils/*": [
        "./src/ts/utils/*"
      ],
      "@types/*": [
        "./src/ts/types/*"
      ]
    }
  },
  "include": [
    "src/ts/**/*.ts",
    "src/ts/**/*.d.ts",
    "src/ts/**/*.vue"
  ],
  "exclude": [
    "src/ts/libs/**",
    "src/ts/toastui/**",
    "node_modules",
    "dist"
  ]
}